{
  "name": "telo3-ai",
  "version": "6.4.0",
  "description": "Always-on engineering contract for AI coding agents: persistent project context, anti-slop discipline, measured token efficiency, and security/privacy/design quality. Mention telo3 once; it stays active.",
  "main": "index.js",
  "type": "module",
  "bin": {
    "telo3": "./cli.js"
  },
  "scripts": {
    "init": "node cli.js init",
    "validate": "node cli.js validate",
    "status": "node cli.js status",
    "activate": "node cli.js activate",
    "test": "node --test test/*.test.js",
    "postinstall": "node scripts/postinstall.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "prepublishOnly": "npm test && npm run verify:release"
  },
  "keywords": [
    "telo3",
    "ai-skill",
    "ai-coding",
    "coding-agent",
    "project-context",
    "ai-memory",
    "context-loss",
    "anti-slop",
    "anti-vibe-coding",
    "token-optimization",
    "systematic-engineering",
    "agents-md",
    "claude",
    "cursor",
    "copilot",
    "gemini",
    "security",
    "privacy",
    "accessibility",
    "design-system",
    "framework-agnostic"
  ],
  "author": {
    "name": "Jeet",
    "url": "https://github.com/jeet1511"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jeet1511/telo3.git"
  },
  "bugs": {
    "url": "https://github.com/Jeet1511/telo3/issues"
  },
  "homepage": "https://github.com/Jeet1511/telo3#readme",
  "files": [
    "SKILL.md",
    "bootstrap/",
    "src/",
    "templates/",
    "references/",
    "hooks/",
    "scripts/postinstall.mjs",
    "cli.js",
    "index.js",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "publishConfig": {
    "access": "public"
  }
}